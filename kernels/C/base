// x1 = n, x8 é base A, x9 é base de B e x10 é base C (matriz destino), pré-carregados
    VSETVL x2, x1               // x1 = n, x2 = vl
    SLLI x3, x1, 2              // x3 = x1 * 2² = 4n
    SLLI x4, x2, 2              // x4 = x2 * 2² = 4vl
    ADD x5, x0, x0              // x5 = 0
    ADD x11, x8, x0             // x11 é cópia do endereço base de A
    ADD x12, x9, x0             // x12 é cópia do endereço base de B
LOOP1:
    ADD x6, x0, x0              // x6 = 0
LOOP2:
    VZERO v1                    // v1 é um vetor de zeros
    ADD x7, x0, x0              // x7 = 0
    MUL x8, x5, x3              // Offset em bytes referente à atual linha de A
    ADD x8, x11, x8             // Atualiza endereço para atual linha de A
    SLLI x9, x6, 2              // Offset em bytes referente à atual coluna de B
    ADD x9, x12, x9             // Atualiza endereço para atual coluna de B
LOOP3:
    ADDI x7, x7, x2             // Incrementa contador de elementos carregados
    VLOAD v2, (x8)              // Carrega vl elementos da linha de A
    VLOAD_STRIDED v3, (x9), x3  // Carrega vl elementos da coluna de B
    VFMA v1, v2, v3             // Z[i] += X[i]*Y[i]
    ADD x8, x8, x4              // Atualiza endereço x8 com deslocamento de 4vl bytes
    ADDI x9, x9, x3             // Atualiza endereço x9 com deslocamento de 4n bytes
    BNE x7, x1, LOOP3           // Se x7 = n, saímos do LOOP3
    VREDSUM f1, v1, f0          // Produto interno de linha de A com coluna de B
    FSW f1, 0(x10)              // Armazena entrada da matriz resultante
    ADDI x10, x10, 4            // Atualiza endereço x10 com deslocamento de 4 bytes
    ADDI x6, x6, 1              // Incrementa contador das colunas de B
    BNE x6, x1, LOOP2           // Se x6 = n, saímos do LOOP2
    ADDI x5, x5, 1              // Incrementa contador das linhas de A
    BNE x5, x1, LOOP1           // Se x5 = n, saímos do LOOP1
FIM:                            // Fim do kernel
